{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/about-us",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/product",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/dealer",
      "destination": "/distributor",
      "permanent": true
    },
    {
      "source": "/dealers",
      "destination": "/distributor",
      "permanent": true
    },
    {
      "source": "/dealer-desk",
      "destination": "/distributor",
      "permanent": true
    },
    {
      "source": "/manufacturing-facilities",
      "destination": "/manufacturing",
      "permanent": true
    },
    {
      "source": "/catalogue",
      "destination": "/products",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "headers": [
    {
      "source": "/(images|videos|fonts|webfonts|docs)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
